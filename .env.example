VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-key

# Análise de Fotos — Gemini Flash-Lite é o padrão. A chave não vai no git.
# VITE_VISION_PROVIDER=gemini
# VITE_VISION_API_KEY=
# VITE_VISION_MODEL=gemini-flash-lite-latest
# OpenAI no navegador costuma bloquear CORS; use Gemini ou um webhook:
# VITE_VISION_PROVIDER=webhook
# VITE_VISION_ENDPOINT=https://seu-projeto.supabase.co/functions/v1/visao

